# Copy to .env and fill in on the machine that runs the server.
# .env is gitignored. Do not put real library paths, passwords, or photos here
# until the app exists, and never commit the filled-in file.

# Where app.db and caches live. Keep it outside the libraries. Default: data (relative to the working dir).
PHOTOS_VIEWER_DATA_DIR=./data

# Not read by the server yet; pass host/port to uvicorn directly for now.
PHOTOS_VIEWER_HOST=127.0.0.1
PHOTOS_VIEWER_PORT=8000

# Session cookies are Secure by default and need HTTPS (Tailscale Serve or tailscale cert).
# Set to false only for local plain-HTTP development. false/0/no/off disable it.
# PHOTOS_VIEWER_COOKIE_SECURE=true

# Session lifetimes in seconds. A non-integer or negative value falls back to the default.
# Desktop browser sign-in (12 hours).
# PHOTOS_VIEWER_SESSION_LIFETIME_DESKTOP_SECONDS=43200
# Installed iPhone PWA sign-in (30 days).
# PHOTOS_VIEWER_SESSION_LIFETIME_PWA_SECONDS=2592000
# Sign-in with "Remember me" ticked, on any client (180 days).
# PHOTOS_VIEWER_REMEMBER_ME_LIFETIME_SECONDS=15552000

# Login lockout (5 failures per username, 30 per IP, in 15 minutes) and Argon2
# parameters are fixed in code and cannot be set here.

# Stops osxphotos from asking PyPI whether a newer release exists.
OSXPHOTOS_NO_VERSION_CHECK=1

# Libraries are registered in the admin panel by path. They are not listed here.
# On Linux, each path must be a mounted .photoslibrary the process can read.

# Copy to .env and fill in on the machine that runs the server.
# .env is gitignored. Do not put real library paths, passwords, or photos here
# until the app exists, and never commit the filled-in file.

PHOTOS_VIEWER_DATA_DIR=./data
PHOTOS_VIEWER_HOST=127.0.0.1
PHOTOS_VIEWER_PORT=8000

# Libraries are registered in the admin panel by path. They are not listed here.
# On Linux, each path must be a mounted .photoslibrary the process can read.

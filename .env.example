# Copy to .env and fill in on the machine that runs the server.
# .env is gitignored. Do not put real library paths, passwords, or photos here
# until the app exists, and never commit the filled-in file.

# Where app.db and caches live. Keep it outside the libraries. Default: data (relative to the working dir).
PHOTOS_VIEWER_DATA_DIR=./data

# Not read by the server yet; pass host/port to uvicorn directly for now.
PHOTOS_VIEWER_HOST=127.0.0.1
PHOTOS_VIEWER_PORT=8000

# Session cookie Secure flag. Default "auto": Secure only when the request arrived over https
# (X-Forwarded-Proto is believed only from loopback / PHOTOS_VIEWER_TRUSTED_PROXIES), so plain
# http://192.168.x.x:8000 or http://homeserver.local:8000 on a home network just works.
# true / false force it.
# PHOTOS_VIEWER_COOKIE_SECURE=auto

# Optional. Browser origin(s), comma-separated scheme://host[:port], accepted in addition to the
# default rule (an Origin whose host:port equals the request's Host header). Cross-site origins
# are always rejected. Only needed when a proxy rewrites Host, e.g. https://myhost.tailxyz.ts.net.
# PHOTOS_VIEWER_PUBLIC_ORIGINS=

# Reverse proxies (comma-separated IPs and/or CIDRs) whose requests are keyed on the
# Tailscale-User-Login header for the per-client login lockout, the way loopback already is.
# Use in Docker when uvicorn's --forwarded-allow-ips (env: FORWARDED_ALLOW_IPS or
# UVICORN_FORWARDED_ALLOW_IPS) can't be pointed at the bridge gateway. Any invalid entry
# stops the server from starting. Unset by default.
# PHOTOS_VIEWER_TRUSTED_PROXIES=172.17.0.1
# With the compose example in server/README.md (pinned network 172.28.0.0/24), the gateway is 172.28.0.1:
# PHOTOS_VIEWER_TRUSTED_PROXIES=172.28.0.1

# Session lifetimes in seconds. A non-integer or negative value falls back to the default.
# Desktop browser sign-in (12 hours).
# PHOTOS_VIEWER_SESSION_LIFETIME_DESKTOP_SECONDS=43200
# Installed iPhone PWA sign-in (30 days).
# PHOTOS_VIEWER_SESSION_LIFETIME_PWA_SECONDS=2592000
# Sign-in with "Remember me" ticked, on any client (180 days).
# PHOTOS_VIEWER_REMEMBER_ME_LIFETIME_SECONDS=15552000

# Per-peer failed-login ceiling: the combined failures across every Tailscale-User-Login value
# seen from one direct peer (loopback or a trusted proxy) in the 15-minute window. Default 300
# (10x the per-client limit of 30). Raise it if many users share one proxy. A non-integer,
# negative, or zero value falls back to the default.
# PHOTOS_VIEWER_MAX_FAILED_LOGINS_PER_PEER=300

# Passkeys (WebAuthn, P3.1). By default the relying-party ID is the request's host name and the
# expected origin is the request's own origin (or PHOTOS_VIEWER_PUBLIC_ORIGINS when that is set),
# which is right behind `tailscale serve`. Set these only to pin them: the RP ID is a bare domain
# (no scheme or port); origins are comma-separated scheme://host[:port]. Changing the RP ID later
# invalidates every registered passkey. Browsers refuse IP addresses as RP IDs.
# PHOTOS_VIEWER_WEBAUTHN_RP_ID=box.example.ts.net
# PHOTOS_VIEWER_WEBAUTHN_ORIGINS=https://box.example.ts.net

# Referenced originals (#78): a photo whose original Photos keeps outside the .photoslibrary
# package is "not available" by default (/original answers 404 "original_not_available" and the
# viewer says so). List extra absolute, read-only roots here (separated by ":" on Linux/macOS)
# to serve originals under them. Paths are resolved, symlinks included, and nothing outside the
# package or these roots is ever served. The server never writes to them. Off by default.
# In Docker, mount each root read-only too.
# PHOTOS_VIEWER_REFERENCED_ROOTS=/mnt/photos-originals:/mnt/other

# Login lockout (5 failures per username, 30 per IP, in 15 minutes) and Argon2
# parameters are fixed in code and cannot be set here.

# Stops osxphotos from asking PyPI whether a newer release exists.
OSXPHOTOS_NO_VERSION_CHECK=1

# Libraries are registered in the admin panel by path. They are not listed here.
# On Linux, each path must be a mounted .photoslibrary the process can read.
